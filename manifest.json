    },
    {
      "id": "calculate-product-metrics",
      "path": "scripts/analytics/calculate_product_metrics.py",
      "domain": "analytics",
      "description": "Calculate explicit activation, engagement, retention, and monetization metrics from supplied counts."
    },
    {
      "id": "calculate-retention-cohorts",
      "path": "scripts/analytics/calculate_retention_cohorts.py",
      "domain": "analytics",
      "description": "Calculate cohort retention tables from explicit retained counts by period."
    },
    {
      "id": "evaluate-evidence-rubric",
      "path": "scripts/discovery/evaluate_evidence_rubric.py",
      "domain": "discovery",
      "description": "Check completeness and balance of product evidence without generating a fake PMF score."
    },
    {
      "id": "compare-prioritization-options",
      "path": "scripts/discovery/compare_prioritization_options.py",
      "domain": "discovery",
      "description": "Compare prioritization options using only user-supplied criteria and weights."
    },
    {
      "id": "validate-user-story",
      "path": "scripts/requirements/validate_user_story.py",
      "domain": "requirements",
      "description": "Validate whether a user story is outcome-linked, testable, and ready for refinement."
    },
    {
      "id": "validate-acceptance-criteria",
      "path": "scripts/requirements/validate_acceptance_criteria.py",
      "domain": "requirements",
      "description": "Validate whether acceptance criteria are observable, complete, and categorized."
    },
    {
      "id": "validate-roadmap-consistency",
      "path": "scripts/delivery/validate_roadmap_consistency.py",
      "domain": "delivery",
      "description": "Check roadmap items for objective alignment, dependency clarity, and release sequencing gaps."
    },
    {
      "id": "validate-okr-cascade",
      "path": "scripts/delivery/validate_okr_cascade.py",
      "domain": "delivery",
      "description": "Check whether objectives, key results, and initiatives form a complete cascade."
